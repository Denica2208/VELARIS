@page
@model ConfirmationModel
@{
    ViewData["Title"] = "Confirmare Comandă — " + (Model.Order?.OrderNumber ?? "VELARIS");
}

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    @if (Model.Order != null)
    {
        <!-- Celebration Banner -->
        <div class="bg-surface/80 border gold-border rounded-3xl p-8 sm:p-10 text-center shadow-2xl relative overflow-hidden mb-10">
            <div class="w-20 h-20 mx-auto rounded-full bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 mb-6 shadow-xl">
                <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            </div>
            
            <span class="text-xs uppercase font-bold text-gold tracking-widest">Comandă Plasată cu Succes</span>
            <h1 class="text-3xl sm:text-4xl font-extrabold font-display text-white mt-2">
                Îți mulțumim pentru comandă!
            </h1>
            <p class="text-slate-300 text-xs sm:text-sm max-w-lg mx-auto mt-2 leading-relaxed">
                Am înregistrat comanda ta în sistemul VELARIS Capsule. Vei primi confirmarea detaliată și notificările de expediere pe email.
            </p>

            <!-- Order Number Badge -->
            <div class="mt-6 inline-flex flex-col sm:flex-row items-center gap-3 bg-canvas border gold-border px-6 py-3 rounded-2xl shadow-inner">
                <span class="text-xs text-slate-400">Număr Unic Comandă (A5):</span>
                <span class="text-xl sm:text-2xl font-black font-display text-gold tracking-wider">@Model.Order.OrderNumber</span>
                <span class="px-2.5 py-1 rounded-full text-[10px] font-bold uppercase bg-amber-500/20 text-amber-300 border border-amber-500/30">
                    Status: @Model.Order.Status
                </span>
            </div>
        </div>

        <!-- Order Summary Card -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">
            <!-- Shipping Details -->
            <div class="bg-surface/70 border gold-border rounded-2xl p-6 shadow-lg">
                <h3 class="text-xs uppercase font-bold text-gold tracking-wider mb-4 flex items-center">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                    Destinatar &amp; Adresă Livrare
                </h3>
                <div class="space-y-1.5 text-xs text-slate-300">
                    <p class="font-bold text-white text-sm">@Model.Order.CustomerName</p>
                    <p class="text-slate-400">@Model.Order.CustomerEmail</p>
                    <p class="mt-2 text-slate-200">@Model.Order.ShippingAddress</p>
                    <p class="text-slate-200">@Model.Order.City, @Model.Order.PostalCode</p>
                    <p class="text-slate-400">România</p>
                </div>
            </div>

            <!-- Courier & Estimated Delivery -->
            <div class="bg-surface/70 border gold-border rounded-2xl p-6 shadow-lg">
                <h3 class="text-xs uppercase font-bold text-gold tracking-wider mb-4 flex items-center">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0"/></svg>
                    Metodă de Expediere
                </h3>
                <div class="space-y-2 text-xs text-slate-300">
                    <div class="flex items-center justify-between">
                        <span class="font-bold text-white">@Model.Order.DeliveryMethod</span>
                        <span class="text-gold font-bold">@Model.Order.ShippingCost.ToString("F2") RON</span>
                    </div>
                    <p class="text-slate-400 leading-relaxed">
                        Pachetul va fi predat curierului în maximum 24 de ore lucrătoare.
                    </p>
                    <div class="pt-2 text-[11px] text-sage flex items-center">
                        <span class="w-2 h-2 rounded-full bg-sage mr-2 animate-pulse"></span>
                        Livrare estimată în 2-3 zile lucrătoare
                    </div>
                </div>
            </div>
        </div>

        <!-- Ordered Items Table -->
        <div class="bg-surface/70 border gold-border rounded-2xl p-6 shadow-lg mb-8">
            <h3 class="text-xs uppercase font-bold text-gold tracking-wider mb-4">
                Piese Comandate (@Model.Order.Items.Sum(i => i.Quantity) articole)
            </h3>

            <div class="space-y-3 divide-y divide-slate-800">
                @foreach (var item in Model.Order.Items)
                {
                    <div class="flex items-center justify-between pt-3 text-xs">
                        <div>
                            <div class="font-bold text-white text-sm">@item.ProductName</div>
                            <div class="text-slate-400 text-[11px] mt-0.5">
                                SKU: @item.SKU &bull; Mărime: <strong class="text-gold">@item.SelectedSize</strong> &bull; Cantitate: @item.Quantity buc.
                            </div>
                        </div>
                        <div class="text-right">
                            <div class="font-bold text-white text-sm">@((item.UnitPrice * item.Quantity).ToString("F2")) RON</div>
                            <div class="text-[11px] text-slate-400">@item.UnitPrice.ToString("F2") RON / buc.</div>
                        </div>
                    </div>
                }
            </div>

            <div class="border-t gold-border pt-4 mt-6 space-y-2 text-xs text-slate-300">
                <div class="flex justify-between">
                    <span>Subtotal</span>
                    <span class="font-bold text-white">@Model.Order.Subtotal.ToString("F2") RON</span>
                </div>
                <div class="flex justify-between">
                    <span>Transport</span>
                    <span class="font-bold text-white">@Model.Order.ShippingCost.ToString("F2") RON</span>
                </div>
                <div class="flex justify-between text-base font-extrabold text-gold pt-2 border-t border-slate-800">
                    <span>Total Achitat</span>
                    <span>@Model.Order.TotalAmount.ToString("F2") RON</span>
                </div>
            </div>
        </div>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row justify-center items-center gap-4">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a href="/Account/Orders" class="w-full sm:w-auto bg-surface hover:bg-gold hover:text-canvas border gold-border text-white text-xs font-bold py-3 px-6 rounded-full transition shadow-md flex items-center justify-center">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                    Vezi Istoricul Comenzilor Mele (A8)
                </a>
            }
            <a href="/" class="w-full sm:w-auto bg-gold hover:bg-gold-light text-canvas text-xs font-bold py-3 px-8 rounded-full transition shadow-lg flex items-center justify-center">
                Continuă la Catalogul Capsule
            </a>
        </div>
    }
</div>
