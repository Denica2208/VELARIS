@page
@model Velaris.Store.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Customer Sign In";
}

<div class="max-w-md mx-auto px-4 py-16">
    <div class="bg-surface border gold-border rounded-3xl p-8 shadow-2xl">
        <div class="text-center mb-8">
            <span class="text-xs uppercase font-bold text-gold tracking-widest">Authentication</span>
            <h1 class="text-2xl font-bold font-display text-white mt-1">Sign In to VELARIS</h1>
            <p class="text-xs text-slate-400 mt-1">Access your saved capsule wardrobe and order history.</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="mb-6 bg-rose-500/10 border border-rose-500/30 text-rose-400 text-xs p-3 rounded-xl">
                @Model.ErrorMessage
            </div>
        }

        <form method="post" class="space-y-4">
            <div>
                <label class="block text-xs font-semibold text-slate-300 mb-1">Email Address</label>
                <input type="email" asp-for="Email" required 
                       class="w-full bg-slate-900 border gold-border rounded-xl px-4 py-2.5 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-gold"
                       placeholder="customer@velaris.com" />
            </div>

            <div>
                <label class="block text-xs font-semibold text-slate-300 mb-1">Password</label>
                <input type="password" asp-for="Password" required 
                       class="w-full bg-slate-900 border gold-border rounded-xl px-4 py-2.5 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-gold"
                       placeholder="••••••••••••" />
            </div>

            <button type="submit" 
                    class="w-full bg-gold hover:bg-gold-light text-canvas text-xs font-bold py-3 px-4 rounded-xl transition font-display uppercase tracking-wider">
                Authenticate Session (A4)
            </button>
        </form>

        <div class="mt-6 pt-6 border-t border-slate-800 text-center text-xs text-slate-400">
            Don't have an account? <a href="/Account/Register" class="text-gold font-semibold hover:underline">Register</a>
        </div>

        <div class="mt-4 p-3 bg-slate-900/60 rounded-xl border border-slate-800 text-[11px] text-slate-400">
            <strong>P2 Demo Test Credentials:</strong><br>
            • Customer: <code>customer@velaris.com</code> (Pass: <code>CustomerPass123!</code>)<br>
            • Admin: <code>admin@velaris.com</code> (Pass: <code>AdminPass123!</code>)
        </div>
    </div>
</div>
