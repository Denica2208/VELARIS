@page
@model Velaris.Store.Pages.Account.OrdersModel
@{
    ViewData["Title"] = "Istoricul Comenzilor Mele";
}

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between pb-8 border-b gold-border mb-8">
        <div>
            <div class="flex items-center space-x-2 text-xs text-slate-400 mb-2">
                <a href="/" class="hover:text-gold transition">Catalog</a>
                <span>/</span>
                <span class="text-gold">Cont Client (A8)</span>
            </div>
            <h1 class="text-3xl sm:text-4xl font-extrabold font-display text-white">Istoricul Comenzilor Mele</h1>
        </div>
        <div class="mt-4 sm:mt-0 flex items-center space-x-3">
            <a href="/" class="text-xs text-slate-300 hover:text-gold transition flex items-center font-medium">
                <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                Continuă cumpărăturile
            </a>
            <a href="/Account/Logout" class="text-xs text-slate-400 hover:text-white transition font-medium border border-slate-700 px-3 py-1.5 rounded-lg">
                Ieșire Cont
            </a>
        </div>
    </div>

    @if (!Model.Orders.Any())
    {
        <!-- Empty State -->
        <div class="bg-surface/60 border gold-border rounded-3xl p-12 text-center max-w-2xl mx-auto my-12 shadow-xl">
            <div class="w-20 h-20 mx-auto rounded-full bg-surface border gold-border flex items-center justify-center text-gold mb-6 shadow-xl">
                <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
            </div>
            <h2 class="text-2xl font-bold font-display text-white mb-2">Nu ai plasat încă nicio comandă</h2>
            <p class="text-sm text-slate-400 mb-8 max-w-md mx-auto">
                După ce finalizezi prima ta comandă capsule, vei putea urmări statusul expedierii și detaliile pieselor aici.
            </p>
            <a href="/" class="bg-gold hover:bg-gold-light text-canvas text-sm font-bold py-3.5 px-8 rounded-full transition shadow-lg inline-flex items-center justify-center">
                Explorează Colecția Noastră
            </a>
        </div>
    }
    else
    {
        <div class="space-y-6">
            @foreach (var order in Model.Orders)
            {
                <div class="bg-surface/80 border gold-border rounded-3xl overflow-hidden shadow-xl transition hover:border-gold/50">
                    <!-- Order Header Bar -->
                    <div class="bg-canvas/80 border-b border-slate-800 p-5 sm:p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                        <div class="flex flex-wrap items-center gap-3">
                            <span class="text-sm font-black font-display text-gold tracking-wider">@order.OrderNumber</span>
                            <span class="text-xs text-slate-400">&bull;</span>
                            <span class="text-xs text-slate-300">@order.CreatedAt.ToString("dd MMMM yyyy, HH:mm")</span>
                            <span class="text-xs text-slate-400">&bull;</span>
                            <span class="text-xs text-slate-400">@order.DeliveryMethod</span>
                        </div>

                        <!-- Live Status Badges (A8) -->
                        <div>
                            @switch (order.Status)
                            {
                                case "Paid":
                                    <span class="px-3 py-1 rounded-full text-xs font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 flex items-center">
                                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 mr-1.5"></span>
                                        Plătită (Paid)
                                    </span>
                                    break;
                                case "Shipped":
                                    <span class="px-3 py-1 rounded-full text-xs font-bold bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 flex items-center">
                                        <span class="w-1.5 h-1.5 rounded-full bg-indigo-400 mr-1.5 animate-pulse"></span>
                                        Expediată (Shipped)
                                    </span>
                                    break;
                                case "Delivered":
                                    <span class="px-3 py-1 rounded-full text-xs font-bold bg-green-500/20 text-green-300 border border-green-500/30 flex items-center">
                                        <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                                        Livrată (Delivered)
                                    </span>
                                    break;
                                case "Cancelled":
                                    <span class="px-3 py-1 rounded-full text-xs font-bold bg-rose-500/20 text-rose-300 border border-rose-500/30">
                                        Anulată (Cancelled)
                                    </span>
                                    break;
                                default:
                                    <span class="px-3 py-1 rounded-full text-xs font-bold bg-amber-500/20 text-amber-300 border border-amber-500/30 flex items-center">
                                        <span class="w-1.5 h-1.5 rounded-full bg-amber-400 mr-1.5 animate-pulse"></span>
                                        Nouă / În procesare (New)
                                    </span>
                                    break;
                            }
                        </div>
                    </div>

                    <!-- Order Line Items -->
                    <div class="p-5 sm:p-6 divide-y divide-slate-800/80">
                        @foreach (var item in order.Items)
                        {
                            <div class="py-3 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
                                <div>
                                    <h4 class="font-bold text-white text-sm">@item.ProductName</h4>
                                    <div class="text-slate-400 mt-1 flex flex-wrap items-center gap-2">
                                        <span>SKU: <code class="text-slate-300">@item.SKU</code></span>
                                        <span>&bull;</span>
                                        <span>Mărime: <strong class="text-gold">@item.SelectedSize</strong></span>
                                        <span>&bull;</span>
                                        <span>Cantitate: <strong>@item.Quantity buc.</strong></span>
                                    </div>
                                </div>
                                <div class="text-right">
                                    <div class="font-extrabold text-white text-sm">@((item.UnitPrice * item.Quantity).ToString("F2")) RON</div>
                                    <div class="text-slate-500 text-[11px]">@item.UnitPrice.ToString("F2") RON / buc.</div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Order Footer -->
                    <div class="bg-canvas/50 border-t border-slate-800 p-5 sm:p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4 text-xs text-slate-400">
                        <div>
                            <span>Adresă Livrare: </span>
                            <span class="text-slate-200">@order.ShippingAddress, @order.City (@order.PostalCode)</span>
                        </div>
                        <div class="flex items-baseline space-x-4">
                            <span>Subtotal: <strong class="text-white">@order.Subtotal.ToString("F2") RON</strong></span>
                            <span>Transport: <strong class="text-white">@order.ShippingCost.ToString("F2") RON</strong></span>
                            <span class="text-sm font-black text-gold font-display">Total: @order.TotalAmount.ToString("F2") RON</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
