@inject Velaris.Store.Services.CartService CartService
@inject Velaris.Store.Services.WishlistService WishlistService
@{
    var cartCount = await CartService.GetCartItemCountAsync();
    var wishlistCount = await WishlistService.GetWishlistCountAsync();
}
<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — VELARIS Capsule Atelier</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        canvas: '#0D1017',
                        surface: '#141A26',
                        'surface-hover': '#1C2436',
                        gold: '#E5B869',
                        'gold-light': '#F3D39B',
                        terracotta: '#E07A5F',
                        sage: '#4EBA87',
                    },
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                        display: ['Outfit', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { background-color: #0D1017; color: #F8FAFC; }
        .gold-border { border-color: rgba(229, 184, 105, 0.2); }
    </style>
</head>
<body class="flex flex-col min-h-screen">
    <!-- Top Announcement Bar -->
    <div class="bg-surface border-b gold-border text-center py-2 px-3 text-[11px] sm:text-xs text-gold-light tracking-widest uppercase font-semibold">
        ✦ Quiet Luxury &amp; Contemporary Capsule Atelier · Livrare Gratuită peste 300 RON
    </div>

    <!-- Navigation Header -->
    <header class="sticky top-0 z-50 bg-canvas/95 backdrop-blur-md border-b gold-border">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-4">
            <div class="flex items-center space-x-6 lg:space-x-8 min-w-0">
                <a href="/" class="text-2xl sm:text-3xl font-extrabold tracking-tighter text-white font-display shrink-0">
                    VELARIS<span class="text-gold">.</span>
                </a>
                <nav class="hidden lg:flex items-center space-x-5 text-xs xl:text-sm font-medium text-slate-300 whitespace-nowrap">
                    <a href="/" class="hover:text-gold transition">Toate</a>
                    <a href="/?category=hoodies" class="hover:text-gold transition">Knitwear</a>
                    <a href="/?category=t-shirts" class="hover:text-gold transition">Cămăși &amp; Topuri</a>
                    <a href="/?category=denim" class="hover:text-gold transition">Pantaloni &amp; Denim</a>
                    <a href="/?category=jackets" class="hover:text-gold transition">Paltoane &amp; Sacouri</a>
                </nav>
            </div>

            <!-- Search & Actions -->
            <div class="flex items-center space-x-2 sm:space-x-3 shrink-0">
                <form method="get" action="/" class="hidden xl:flex items-center relative">
                    <input type="text" name="search" placeholder="Caută piese..." 
                           class="bg-surface border gold-border rounded-full py-1.5 pl-4 pr-9 text-xs text-white placeholder-slate-400 focus:outline-none focus:border-gold w-44" />
                    <button type="submit" class="absolute right-3 text-slate-400 hover:text-gold" title="Căutare">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                    </button>
                </form>

                <!-- Wishlist Icon (B7) -->
                <a href="/Wishlist" class="relative text-slate-300 hover:text-gold p-2 rounded-xl bg-surface/60 border gold-border transition flex items-center justify-center hover:bg-surface" title="Favorite (B7)">
                    <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
                    @if (wishlistCount > 0)
                    {
                        <span class="absolute -top-1.5 -right-1.5 bg-rose-500 text-white text-[10px] font-bold w-4 h-4 rounded-full flex items-center justify-center ring-2 ring-canvas animate-pulse">@wishlistCount</span>
                    }
                </a>

                <!-- Cart Icon (A3) -->
                <a href="/Cart" class="relative text-slate-300 hover:text-gold p-2 rounded-xl bg-surface/60 border gold-border transition flex items-center justify-center hover:bg-surface" title="Coș de cumpărături (A3)">
                    <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
                    @if (cartCount > 0)
                    {
                        <span class="absolute -top-1.5 -right-1.5 bg-gold text-canvas text-[10px] font-extrabold w-4 h-4 rounded-full flex items-center justify-center ring-2 ring-canvas">@cartCount</span>
                    }
                </a>

                <!-- User Account / Orders (A8) -->
                <div class="flex items-center space-x-2 pl-1 sm:pl-2 text-xs">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a href="/Account/Orders" class="hidden sm:inline-flex items-center text-gold hover:text-gold-light font-bold bg-surface border gold-border px-3 py-1.5 rounded-full transition" title="Istoric Comenzi (A8)">
                            <svg class="w-3.5 h-3.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                            Comenzi
                        </a>
                        <a href="/Account/Logout" class="text-slate-400 hover:text-white transition px-2 py-1">Ieșire</a>
                    }
                    else
                    {
                        <a href="/Account/Login" class="text-slate-300 hover:text-gold font-medium px-2 py-1 transition">Conectare</a>
                        <a href="/Account/Register" class="bg-gold/10 border border-gold/40 text-gold px-3 py-1 rounded-full hover:bg-gold hover:text-canvas transition font-bold hidden sm:inline-block">Cont Nou</a>
                    }
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main role="main" class="flex-grow">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-surface border-t gold-border mt-20 py-12 text-sm text-slate-400">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-4 gap-8">
            <div>
                <span class="text-2xl font-bold font-display text-white tracking-tight">VELARIS<span class="text-gold">.</span></span>
                <p class="mt-3 text-xs leading-relaxed text-slate-400">
                    Atelier contemporan de modă minimalistă și garderobă capsule — cașmir, in european, mătase și croiuri atemporale.
                </p>
            </div>
            <div>
                <h4 class="text-xs font-bold uppercase tracking-wider text-gold mb-3">Colecții</h4>
                <ul class="space-y-1.5 text-xs">
                    <li><a href="/?category=hoodies" class="hover:text-white">Knitwear &amp; Cashmere</a></li>
                    <li><a href="/?category=t-shirts" class="hover:text-white">Shirts, Blouses &amp; Tops</a></li>
                    <li><a href="/?category=denim" class="hover:text-white">Tailored Trousers &amp; Denim</a></li>
                    <li><a href="/?category=jackets" class="hover:text-white">Coats, Blazers &amp; Outerwear</a></li>
                </ul>
            </div>
            <div>
                <h4 class="text-xs font-bold uppercase tracking-wider text-gold mb-3">Engineering Spec</h4>
                <ul class="space-y-1.5 text-xs">
                    <li>ASP.NET Core 8.0 &amp; C#</li>
                    <li>SQLite Relational Database (EF Core)</li>
                    <li>Stripe Sandbox Webhook Flow</li>
                    <li>Mobile Responsive (360px Viewport)</li>
                </ul>
            </div>
            <div>
                <h4 class="text-xs font-bold uppercase tracking-wider text-gold mb-3">Academic Team</h4>
                <p class="text-xs leading-relaxed">
                    <strong>Predut Andreea-Denisa</strong> (Frontend &amp; UX)<br>
                    <strong>Sapca Roman-Stefan</strong> (Backend &amp; DB)<br>
                    E-Commerce Semester Project 2026–2027
                </p>
            </div>
        </div>
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-8 pt-6 border-t border-slate-800 text-center text-xs text-slate-500">
            &copy; 2026 VELARIS Atelier. All rights reserved. Stage P2 Approved Prototype.
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
