@page
@model IndexModel
@{
    ViewData["Title"] = "Capsule Catalogue";
}

<!-- Hero Editorial Banner -->
<section class="py-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-b gold-border">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
            <span class="text-xs uppercase tracking-widest text-gold font-bold">Atelier Capsule Drop · 2026</span>
            <h1 class="text-4xl sm:text-5xl font-extrabold font-display tracking-tight text-white mt-2">
                Curated Streetwear Essentials
            </h1>
            <p class="text-slate-400 text-sm sm:text-base mt-2 max-w-xl">
                Minimalist silhouettes, heavyweight fabrics (up to 500 GSM), and certified organic textiles. Designed for timeless capsule rotation.
            </p>
        </div>

        <!-- Category Filter Pills -->
        <div class="flex flex-wrap gap-2">
            <a href="/" class="px-4 py-1.5 rounded-full text-xs font-semibold border transition @(string.IsNullOrEmpty(Model.CurrentCategory) ? "bg-gold text-canvas border-gold" : "border-slate-700 text-slate-300 hover:border-gold")">
                All (32)
            </a>
            @foreach (var cat in Model.Categories)
            {
                <a href="/?category=@cat.Slug" class="px-4 py-1.5 rounded-full text-xs font-semibold border transition @(Model.CurrentCategory == cat.Slug ? "bg-gold text-canvas border-gold" : "border-slate-700 text-slate-300 hover:border-gold")">
                    @cat.Name
                </a>
            }
        </div>
    </div>
</section>

<!-- Product Catalog Grid -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
    {
        <div class="mb-6 flex items-center justify-between bg-surface border gold-border p-4 rounded-xl">
            <span class="text-sm text-slate-300">
                Search results for: <strong class="text-gold">"@Model.SearchQuery"</strong>
            </span>
            <a href="/" class="text-xs text-slate-400 hover:text-white underline">Clear search</a>
        </div>
    }

    @if (!Model.Products.Any())
    {
        <!-- Empty State (Requirement A2) -->
        <div class="text-center py-24 bg-surface border gold-border rounded-2xl p-8 max-w-lg mx-auto">
            <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-slate-800 flex items-center justify-center text-slate-400">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            </div>
            <h3 class="text-lg font-bold text-white mb-2">No garments found</h3>
            <p class="text-slate-400 text-xs leading-relaxed mb-6">
                We couldn't find any clothing items matching your search criteria. Try a different keyword like "hoodie", "denim", or browse our category collections.
            </p>
            <a href="/" class="inline-block bg-gold text-canvas text-xs font-bold px-6 py-2.5 rounded-full hover:bg-gold-light transition">
                Reset All Filters
            </a>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            @foreach (var item in Model.Products)
            {
                <div class="bg-surface border gold-border rounded-2xl overflow-hidden flex flex-col group hover:border-gold/60 transition shadow-lg">
                    <!-- Image Container -->
                    <div class="relative aspect-[4/5] overflow-hidden bg-slate-900">
                        <img src="@item.ImageUrl" alt="@item.Name" 
                             class="w-full h-full object-cover object-center group-hover:scale-105 transition duration-500" loading="lazy" />
                        <div class="absolute top-3 left-3 bg-canvas/80 backdrop-blur-md border gold-border px-2.5 py-1 rounded-full text-[10px] font-bold text-gold uppercase tracking-wider">
                            @item.FabricGsm GSM
                        </div>
                        <div class="absolute top-3 right-3 bg-canvas/80 backdrop-blur-md px-2.5 py-1 rounded-full text-[10px] font-bold @(item.StockLevel > 0 ? "text-sage" : "text-terracotta")">
                            @(item.StockLevel > 0 ? $"{item.StockLevel} in stock" : "Sold Out")
                        </div>
                    </div>

                    <!-- Details -->
                    <div class="p-5 flex flex-col flex-grow">
                        <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400">@item.Category?.Name</span>
                        <h3 class="text-base font-bold text-white mt-1 group-hover:text-gold transition font-display">
                            <a href="/Product?slug=@item.Slug">@item.Name</a>
                        </h3>
                        <p class="text-xs text-slate-400 mt-2 line-clamp-2 leading-relaxed">
                            @item.Description
                        </p>

                        <div class="mt-auto pt-4 border-t border-slate-800 flex items-center justify-between">
                            <div>
                                <span class="text-xs text-slate-400">Price</span>
                                <div class="text-base font-extrabold text-white">@item.Price.ToString("F2") RON</div>
                            </div>
                            <a href="/Product?slug=@item.Slug" class="bg-slate-800 hover:bg-gold hover:text-canvas text-slate-200 text-xs font-bold px-3.5 py-2 rounded-xl transition">
                                View Specs
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination Controls (Requirement A1) -->
        @if (Model.TotalPages > 1)
        {
            <div class="mt-12 flex justify-center items-center space-x-2">
                @if (Model.CurrentPage > 1)
                {
                    <a href="/?page=@(Model.CurrentPage - 1)&category=@Model.CurrentCategory&search=@Model.SearchQuery" 
                       class="px-4 py-2 rounded-lg bg-surface border gold-border text-xs text-slate-300 hover:text-gold transition">
                        &larr; Prev
                    </a>
                }
                
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <a href="/?page=@i&category=@Model.CurrentCategory&search=@Model.SearchQuery" 
                       class="w-8 h-8 flex items-center justify-center rounded-lg text-xs font-bold border transition @(i == Model.CurrentPage ? "bg-gold text-canvas border-gold" : "bg-surface border-slate-700 text-slate-300 hover:border-gold")">
                        @i
                    </a>
                }

                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <a href="/?page=@(Model.CurrentPage + 1)&category=@Model.CurrentCategory&search=@Model.SearchQuery" 
                       class="px-4 py-2 rounded-lg bg-surface border gold-border text-xs text-slate-300 hover:text-gold transition">
                        Next &rarr;
                    </a>
                }
            </div>
        }
    }
</section>
