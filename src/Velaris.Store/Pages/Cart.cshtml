@page
@model CartModel
@{
    ViewData["Title"] = "Coș de Cumpărături";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Breadcrumb & Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between pb-8 border-b gold-border mb-8">
        <div>
            <div class="flex items-center space-x-2 text-xs text-slate-400 mb-2">
                <a href="/" class="hover:text-gold transition">Catalog</a>
                <span>/</span>
                <span class="text-gold">Coș de Cumpărături (A3)</span>
            </div>
            <h1 class="text-3xl sm:text-4xl font-extrabold font-display text-white">Coșul Tău Capsule</h1>
        </div>
        <div class="mt-4 sm:mt-0 flex items-center space-x-3">
            <a href="/" class="text-xs text-slate-300 hover:text-gold transition flex items-center font-medium">
                <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                Continuă cumpărăturile
            </a>
            @if (Model.Items.Any())
            {
                <form method="post" asp-page-handler="Clear" onsubmit="return confirm('Sigur dorești să golești întreg coșul?');">
                    <button type="submit" class="text-xs text-rose-400 hover:text-rose-300 transition font-medium border border-rose-500/20 px-3 py-1.5 rounded-lg hover:bg-rose-500/10">
                        Golește coșul
                    </button>
                </form>
            }
        </div>
    </div>

    <!-- Alert Messages (Stock Rejection or Success) -->
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="mb-6 p-4 rounded-2xl bg-rose-950/40 border border-rose-500/40 text-rose-200 text-sm flex items-start space-x-3 shadow-lg animate-pulse">
            <svg class="w-5 h-5 text-rose-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
            <div>
                <strong class="font-bold block">Atenție: Validare Stoc Eșuată</strong>
                <span>@Model.ErrorMessage</span>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="mb-6 p-4 rounded-2xl bg-emerald-950/40 border border-emerald-500/40 text-emerald-200 text-sm flex items-start space-x-3 shadow-lg">
            <svg class="w-5 h-5 text-emerald-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            <div>@Model.SuccessMessage</div>
        </div>
    }

    @if (!Model.Items.Any())
    {
        <!-- Empty Cart State -->
        <div class="bg-surface/60 border gold-border rounded-3xl p-12 text-center max-w-2xl mx-auto my-12">
            <div class="w-20 h-20 mx-auto rounded-full bg-surface border gold-border flex items-center justify-center text-gold mb-6 shadow-xl">
                <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
            </div>
            <h2 class="text-2xl font-bold font-display text-white mb-2">Coșul tău de cumpărături este gol</h2>
            <p class="text-sm text-slate-400 mb-8 max-w-md mx-auto">
                Explorează colecțiile noastre sustenabile de streetwear minimalist și adaugă piesele tale favorite în garderobă.
            </p>
            <div class="flex flex-col sm:flex-row justify-center gap-4">
                <a href="/" class="bg-gold hover:bg-gold-light text-canvas text-sm font-bold py-3 px-8 rounded-full transition shadow-lg inline-flex items-center justify-center">
                    Descoperă Catalogul Complet
                </a>
                <a href="/Wishlist" class="border gold-border hover:border-gold text-slate-300 hover:text-white text-sm font-semibold py-3 px-6 rounded-full transition inline-flex items-center justify-center">
                    Vezi Favoritele Mele
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- Free Shipping Tracker -->
        <div class="bg-surface/70 border gold-border rounded-2xl p-4 mb-8">
            <div class="flex items-center justify-between text-xs mb-2">
                @if (Model.Subtotal >= 300m)
                {
                    <span class="text-sage font-bold flex items-center">
                        <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                        Felicitări! Beneficiezi de Livrare Gratuită pentru această comandă!
                    </span>
                    <span class="text-sage font-bold">100%</span>
                }
                else
                {
                    var needed = 300m - Model.Subtotal;
                    var percent = Math.Min(100, (int)((Model.Subtotal / 300m) * 100));
                    <span class="text-slate-300">
                        Adaugă încă <strong class="text-gold">@needed.ToString("F2") RON</strong> pentru a primi <strong class="text-white">Livrare Gratuită</strong>!
                    </span>
                    <span class="text-gold font-bold">@percent%</span>
                }
            </div>
            <div class="w-full bg-canvas rounded-full h-2 overflow-hidden border border-slate-800">
                <div class="bg-gradient-to-r from-gold to-sage h-2 rounded-full transition-all duration-500" 
                     style="width: @(Math.Min(100, (int)((Model.Subtotal / 300m) * 100)))%"></div>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
            <!-- Cart Items List (8 cols) -->
            <div class="lg:col-span-8 space-y-4">
                @foreach (var item in Model.Items)
                {
                    var product = item.Product;
                    var lineTotal = (product?.Price ?? 0m) * item.Quantity;
                    var isStockLow = product != null && product.StockLevel <= 5;

                    <div class="bg-surface/70 border gold-border rounded-2xl p-4 sm:p-5 flex flex-col sm:flex-row items-center sm:items-stretch gap-5 transition hover:border-gold/40">
                        <!-- Product Thumbnail -->
                        <div class="w-24 h-28 sm:w-28 sm:h-32 rounded-xl overflow-hidden bg-canvas border border-slate-800 flex-shrink-0 relative">
                            <img src="@(product?.ImageUrl ?? "/images/products/nocturne-oversized-hoodie.jpg")" 
                                 alt="@(product?.Name ?? "Garment")" 
                                 class="w-full h-full object-cover" />
                            @if (product != null && product.StockLevel < item.Quantity)
                            {
                                <div class="absolute inset-0 bg-rose-950/80 backdrop-blur-xs flex items-center justify-center text-center p-1">
                                    <span class="text-[10px] font-bold text-rose-300">Stoc depășit</span>
                                </div>
                            }
                        </div>

                        <!-- Details & Size -->
                        <div class="flex-grow flex flex-col justify-between text-center sm:text-left w-full sm:w-auto">
                            <div>
                                <div class="flex items-center justify-center sm:justify-between">
                                    <span class="text-[11px] font-bold uppercase tracking-widest text-gold">@product?.Category?.Name</span>
                                    <span class="hidden sm:inline-block text-[11px] text-slate-500">SKU: @product?.SKU</span>
                                </div>
                                <h3 class="text-base sm:text-lg font-bold text-white mt-0.5">
                                    <a href="/Product/@product?.Slug" class="hover:text-gold transition">
                                        @product?.Name
                                    </a>
                                </h3>
                                <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2 mt-2">
                                    <span class="text-xs bg-canvas border border-slate-700 px-2.5 py-1 rounded-md text-slate-200">
                                        Mărime: <strong class="text-gold font-bold">@item.SelectedSize</strong>
                                    </span>
                                    <span class="text-xs text-slate-400">
                                        Preț unitar: <strong class="text-slate-200">@((product?.Price ?? 0m).ToString("F2")) RON</strong>
                                    </span>
                                    @if (product != null)
                                    {
                                        <span class="text-[11px] @(isStockLow ? "text-amber-400" : "text-slate-400")">
                                            (Stoc: @product.StockLevel buc.)
                                        </span>
                                    }
                                </div>
                            </div>

                            <!-- Stepper & Price on Mobile / Desktop -->
                            <div class="flex items-center justify-between mt-4 pt-3 border-t border-slate-800/80">
                                <!-- Stepper Form -->
                                <div class="flex items-center space-x-1 bg-canvas border border-slate-800 rounded-lg p-1">
                                    <form method="post" asp-page-handler="UpdateQuantity" class="inline">
                                        <input type="hidden" name="cartItemId" value="@item.Id" />
                                        <input type="hidden" name="quantity" value="@(item.Quantity - 1)" />
                                        <button type="submit" title="Scade cantitatea" class="w-7 h-7 flex items-center justify-center rounded text-slate-400 hover:text-white hover:bg-surface transition">
                                            -
                                        </button>
                                    </form>

                                    <span class="w-8 text-center text-xs font-bold text-white">@item.Quantity</span>

                                    <form method="post" asp-page-handler="UpdateQuantity" class="inline">
                                        <input type="hidden" name="cartItemId" value="@item.Id" />
                                        <input type="hidden" name="quantity" value="@(item.Quantity + 1)" />
                                        <button type="submit" title="Crește cantitatea" class="w-7 h-7 flex items-center justify-center rounded text-slate-400 hover:text-white hover:bg-surface transition">
                                            +
                                        </button>
                                    </form>
                                </div>

                                <!-- Subtotal per Line -->
                                <div class="text-right">
                                    <div class="text-sm sm:text-base font-extrabold text-white">
                                        @lineTotal.ToString("F2") RON
                                    </div>
                                    <form method="post" asp-page-handler="Remove" class="inline">
                                        <input type="hidden" name="cartItemId" value="@item.Id" />
                                        <button type="submit" class="text-[11px] text-slate-400 hover:text-rose-400 transition inline-flex items-center mt-0.5">
                                            <svg class="w-3.5 h-3.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                            Elimină
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Order Summary Card (4 cols) -->
            <div class="lg:col-span-4">
                <div class="bg-surface/80 border gold-border rounded-3xl p-6 sm:p-7 shadow-2xl sticky top-28">
                    <h2 class="text-lg font-bold font-display text-white pb-4 border-b gold-border mb-4">
                        Sumar Comandă
                    </h2>

                    <div class="space-y-3 text-xs sm:text-sm text-slate-300">
                        <div class="flex justify-between">
                            <span>Subtotal articole (@Model.Items.Sum(i => i.Quantity) buc.)</span>
                            <span class="font-bold text-white">@Model.Subtotal.ToString("F2") RON</span>
                        </div>
                        <div class="flex justify-between">
                            <span>Livrare estimată (Fan Courier)</span>
                            @if (Model.EstimatedShipping == 0.00m)
                            {
                                <span class="text-sage font-bold">Gratuit</span>
                            }
                            else
                            {
                                <span class="font-bold text-white">@Model.EstimatedShipping.ToString("F2") RON</span>
                            }
                        </div>
                        <div class="flex justify-between text-slate-400 text-xs">
                            <span>TVA (19% inclus)</span>
                            <span>@((Model.Subtotal * 0.19m / 1.19m).ToString("F2")) RON</span>
                        </div>
                    </div>

                    <div class="border-t gold-border pt-4 mt-4 flex justify-between items-baseline">
                        <span class="text-base font-bold text-white">Total Estimat</span>
                        <div class="text-right">
                            <span class="text-2xl font-extrabold text-gold font-display">@Model.Total.ToString("F2") RON</span>
                        </div>
                    </div>

                    <!-- Checkout CTA -->
                    <div class="mt-6 space-y-3">
                        <a href="/Checkout" class="w-full bg-gold hover:bg-gold-light text-canvas text-sm font-bold py-3.5 px-6 rounded-2xl shadow-xl transition duration-200 flex items-center justify-center">
                            <span>Finalizează Comanda (A5)</span>
                            <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                        </a>
                        <p class="text-[11px] text-center text-slate-400">
                            🔒 Tranzacție securizată SSL · Verificare stoc în timp real (A3)
                        </p>
                    </div>

                    <!-- Capsule Perks -->
                    <div class="border-t border-slate-800/80 pt-5 mt-5 space-y-2.5 text-xs text-slate-400">
                        <div class="flex items-center">
                            <svg class="w-4 h-4 mr-2 text-gold flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            Bumbac organic 100% cu certificare GOTS
                        </div>
                        <div class="flex items-center">
                            <svg class="w-4 h-4 mr-2 text-gold flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            Retur garantat gratuit în 30 de zile
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
