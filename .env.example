# VELARIS Environment Configuration Template
# Copy this file to .env and adjust local secrets. Never commit .env to Git!

# ASP.NET Core Environment
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000;https://localhost:7001

# Database Configuration (SQLite default for zero-config portability)
CONNECTION_STRING=Data Source=velaris.db

# Stripe Sandbox Configuration (Test Mode)
STRIPE_PUBLIC_KEY=pk_test_placeholder_velaris
STRIPE_SECRET_KEY=sk_test_placeholder_velaris
STRIPE_WEBHOOK_SECRET=whsec_placeholder_velaris

# Mailtrap Transactional Email (Testing)
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USERNAME=placeholder_user
MAILTRAP_PASSWORD=placeholder_pass

# Admin Seed Account
ADMIN_DEFAULT_EMAIL=admin@velaris.com
ADMIN_DEFAULT_PASSWORD=AdminPass123!
